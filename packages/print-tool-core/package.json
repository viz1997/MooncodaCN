{
  "name": "@mooncoda/print-tool-core",
  "version": "0.1.0",
  "description": "打印服务的几何 / 克重 / 报价引擎 —— 纯 TypeScript、零依赖、浏览器 / Node / Worker 同构",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mesh": "./src/mesh/index.ts",
    "./weight": "./src/weight/index.ts",
    "./pricing": "./src/pricing/index.ts",
    "./quote": "./src/quote/index.ts",
    "./parse": "./src/parse/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": ["3d-print", "slicer", "weight", "pricing", "mesh", "obj"],
  "publishConfig": {
    "access": "public"
  }
}
